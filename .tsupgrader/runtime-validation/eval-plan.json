{
  "projectType": "webapp",
  "devServer": {
    "command": "npm",
    "args": ["run", "dev", "--", "--hostname", "127.0.0.1", "--port", "3000"],
    "url": "http://127.0.0.1:3000/"
  },
  "setup": [
    {
      "command": "npm",
      "args": ["install"]
    }
  ],
  "assertions": [
    {
      "name": "typecheck",
      "kind": "process",
      "command": "npm",
      "args": ["run", "typecheck"],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "tests-pass",
      "kind": "process",
      "command": "npm",
      "args": ["run", "test:e2e"],
      "verificationMethod": "test-results",
      "expected": "0",
      "timeoutSeconds": 300
    },
    {
      "name": "dev-server-serves-home",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": ["run", "dev", "--", "--hostname", "127.0.0.1", "--port", "3000"],
      "url": "http://127.0.0.1:3000/",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 120
    }
  ]
}
