generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGE
  TRANSFER
}

enum InventoryMovementDirection {
  IN
  OUT
}

enum SaleChannel {
  WEB
  POS
}

enum SaleStatus {
  DRAFT
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum AuthProvider {
  GOOGLE
}

enum EmploymentStatus {
  ACTIVE
  ENDED
}

enum Currency {
  GTQ
}

enum PayFrequency {
  MONTHLY
  BIWEEKLY
}

enum ShiftType {
  DAY
  EVENING
  NIGHT
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  CASH_IN
  CASH_OUT
  SALE
}

enum PayrollPeriodStatus {
  DRAFT
  CLOSED
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String?
  emailVerified Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  authAccounts              AuthAccount[]
  sessions                  Session[]
  roles                     UserRole[]
  employee                  Employee?
  adjustedAttendanceRecords AttendanceRecord[]
  sales                     Sale[]             @relation("CustomerSales")
  openedCashSessions        CashSession[]      @relation("CashSessionOpenedBy")
  closedCashSessions        CashSession[]      @relation("CashSessionClosedBy")
  cashMovements             CashMovement[]
  inventoryMovements        InventoryMovement[]
  payrollPeriodsCreated     PayrollPeriod[]     @relation("PayrollPeriodCreatedBy")
  payrollPeriodsClosed      PayrollPeriod[]     @relation("PayrollPeriodClosedBy")
  payrollSlipsAdjusted      PayrollSlip[]       @relation("PayrollSlipAdjustedBy")
}

model AuthAccount {
  id                String       @id @default(cuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Employee {
  id        String   @id @default(cuid())
  userId    String?  @unique
  code      String   @unique
  firstName String?
  lastName  String?
  email     String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  employments Employment[]
  attendance  AttendanceRecord[]
  sales       Sale[]             @relation("EmployeeSales")
  payrollSlips PayrollSlip[]

  @@index([isActive])
}

model PayrollPeriod {
  id              String              @id @default(cuid())
  name            String
  startDate       DateTime            @db.Date
  endDate         DateTime            @db.Date
  status          PayrollPeriodStatus @default(DRAFT)
  createdByUserId String
  closedByUserId  String?
  closedAt        DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  createdBy User         @relation("PayrollPeriodCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  closedBy  User?        @relation("PayrollPeriodClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  slips     PayrollSlip[]

  @@unique([startDate, endDate])
  @@index([status])
  @@index([startDate, endDate])
}

model PayrollSlip {
  id           String   @id @default(cuid())
  periodId     String
  employeeId   String
  employmentId String

  employeeCode String
  employeeName String
  positionName String
  baseCompensation Decimal  @db.Decimal(12, 2)
  currency         Currency @default(GTQ)
  payFrequency     PayFrequency

  daysConsidered Int @default(0)
  presentDays    Int @default(0)
  lateDays       Int @default(0)
  absentDays     Int @default(0)
  excusedDays    Int @default(0)
  lateMinutes    Int @default(0)

  grossAmount       Decimal @db.Decimal(12, 2)
  adjustmentsAmount Decimal @default(0) @db.Decimal(12, 2)
  adjustmentReason  String?
  adjustedByUserId  String?
  netAmount         Decimal @db.Decimal(12, 2)

  requiresReview Boolean @default(false)
  reviewReason   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  period     PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employment Employment    @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  adjustedBy User?         @relation("PayrollSlipAdjustedBy", fields: [adjustedByUserId], references: [id], onDelete: SetNull)

  @@unique([periodId, employeeId])
  @@index([periodId])
  @@index([employeeId])
  @@index([employmentId])
}

model Position {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employments Employment[]

  @@index([isActive])
}

model Employment {
  id         String           @id @default(cuid())
  employeeId String
  positionId String
  startDate  DateTime         @db.Date
  endDate    DateTime?        @db.Date
  status     EmploymentStatus @default(ACTIVE)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  employee            Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  position            Position             @relation(fields: [positionId], references: [id], onDelete: Restrict)
  compensationPeriods CompensationPeriod[]
  shiftAssignments    ShiftAssignment[]
  attendanceRecords   AttendanceRecord[]
  cashSessions        CashSession[]
  payrollSlips        PayrollSlip[]

  @@index([employeeId])
  @@index([positionId])
  @@index([status])
  @@index([employeeId, startDate])
}

model CompensationPeriod {
  id            String       @id @default(cuid())
  employmentId  String
  amount        Decimal      @db.Decimal(12, 2)
  currency      Currency     @default(GTQ)
  payFrequency  PayFrequency
  effectiveFrom DateTime     @db.Date
  effectiveTo   DateTime?    @db.Date
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  employment Employment @relation(fields: [employmentId], references: [id], onDelete: Restrict)

  @@index([employmentId])
  @@index([employmentId, effectiveFrom])
  @@index([employmentId, effectiveTo])
}

model Shift {
  id        String    @id @default(cuid())
  name      String
  code      String    @unique
  type      ShiftType
  startTime DateTime  @db.Time(0)
  endTime   DateTime  @db.Time(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  workDays    ShiftWorkDay[]
  assignments ShiftAssignment[]

  @@index([type])
  @@index([isActive])
}

model ShiftWorkDay {
  shiftId String
  day     Weekday

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@id([shiftId, day])
  @@index([day])
}

model ShiftAssignment {
  id            String    @id @default(cuid())
  employmentId  String
  shiftId       String
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employment Employment         @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  shift      Shift              @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  attendance AttendanceRecord[]

  @@index([employmentId])
  @@index([shiftId])
  @@index([employmentId, effectiveFrom])
  @@index([employmentId, effectiveTo])
}

model AttendanceRecord {
  id String @id @default(cuid())

  employeeId        String
  employmentId      String
  shiftAssignmentId String?
  workDate          DateTime @db.Date

  expectedShiftName       String?
  expectedShiftType       ShiftType?
  expectedStartTime       DateTime?  @db.Time(0)
  expectedEndTime         DateTime?  @db.Time(0)
  expectedCrossesMidnight Boolean?

  clockInAt  DateTime?
  clockOutAt DateTime?

  status           AttendanceStatus
  lateMinutes      Int              @default(0)
  notes            String?
  adjustedByUserId String?
  adjustmentReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employment      Employment       @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  shiftAssignment ShiftAssignment? @relation(fields: [shiftAssignmentId], references: [id], onDelete: SetNull)
  adjustedBy      User?            @relation(fields: [adjustedByUserId], references: [id], onDelete: SetNull)

  @@unique([employmentId, workDate])
  @@index([employeeId])
  @@index([employeeId, workDate])
  @@index([workDate])
  @@index([status])
  @@index([shiftAssignmentId])
  @@index([adjustedByUserId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String
  sku            String   @unique
  barcode        String?  @unique
  price          Decimal  @db.Decimal(12, 2)
  previousPrice  Decimal? @db.Decimal(12, 2)
  categoryId     String
  brandId        String?
  hasRgbLighting Boolean  @default(false)
  isActive       Boolean  @default(true)
  isFeatured     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category           Category               @relation(fields: [categoryId], references: [id])
  brand              Brand?                 @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images             ProductImage[]
  specifications     ProductSpecification[]
  inventory          Inventory?
  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([hasRgbLighting])
  @@index([isActive])
  @@index([isFeatured])
}

model ProductSpecification {
  id            String   @id @default(cuid())
  productId     String
  label         String
  value         String
  sortOrder     Int      @default(0)
  isHighlighted Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, sortOrder])
  @@index([productId, isHighlighted])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, sortOrder])
}

model Inventory {
  id               String   @id @default(cuid())
  productId        String   @unique
  physicalQuantity Int      @default(0)
  reservedQuantity Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model InventoryMovement {
  id         String                     @id @default(cuid())
  productId  String
  saleId     String?
  type       InventoryMovementType
  direction  InventoryMovementDirection
  quantity   Int
  reference  String?
  note       String?
  createdByUserId String?
  occurredAt DateTime                   @default(now())

  product Product @relation(fields: [productId], references: [id])
  sale    Sale?   @relation(fields: [saleId], references: [id], onDelete: Restrict)
  createdBy User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([saleId])
  @@index([type])
  @@index([direction])
  @@index([occurredAt])
  @@index([createdByUserId])
}

model Sale {
  id              String      @id @default(cuid())
  saleNumber      String      @unique
  channel         SaleChannel
  customerId      String?
  employeeId      String?
  cashSessionId   String?
  clientRequestId String?     @unique
  status          SaleStatus  @default(PENDING)
  subtotal        Decimal     @db.Decimal(12, 2)
  discount        Decimal     @default(0) @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  customer           User?               @relation("CustomerSales", fields: [customerId], references: [id], onDelete: SetNull)
  employee           Employee?           @relation("EmployeeSales", fields: [employeeId], references: [id], onDelete: SetNull)
  cashSession        CashSession?        @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  items              SaleItem[]
  payments           Payment[]
  cashMovement       CashMovement?
  inventoryMovements InventoryMovement[]

  @@index([channel])
  @@index([customerId])
  @@index([employeeId])
  @@index([cashSessionId])
  @@index([status])
  @@index([createdAt])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  productId   String
  productName String
  sku         String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id                String        @id @default(cuid())
  saleId            String
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Decimal       @db.Decimal(12, 2)
  changeAmount      Decimal       @default(0) @db.Decimal(12, 2)
  externalReference String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([method])
  @@index([status])
}

model CashRegister {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions CashSession[]

  @@index([isActive])
}

model CashSession {
  id                    String            @id @default(cuid())
  cashRegisterId        String
  employmentId          String
  openedByUserId        String
  closedByUserId        String?
  openedAt              DateTime          @default(now())
  closedAt              DateTime?
  openingAmount         Decimal           @db.Decimal(12, 2)
  expectedClosingAmount Decimal?          @db.Decimal(12, 2)
  actualClosingAmount   Decimal?          @db.Decimal(12, 2)
  differenceAmount      Decimal?          @db.Decimal(12, 2)
  status                CashSessionStatus @default(OPEN)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  cashRegister CashRegister   @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  employment   Employment     @relation(fields: [employmentId], references: [id], onDelete: Restrict)
  openedBy     User           @relation("CashSessionOpenedBy", fields: [openedByUserId], references: [id], onDelete: Restrict)
  closedBy     User?          @relation("CashSessionClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  movements    CashMovement[]
  sales        Sale[]

  @@index([cashRegisterId])
  @@index([employmentId])
  @@index([openedByUserId])
  @@index([closedByUserId])
  @@index([status])
  @@index([openedAt])
}

model CashMovement {
  id              String           @id @default(cuid())
  cashSessionId   String
  type            CashMovementType
  amount          Decimal          @db.Decimal(12, 2)
  reason          String?
  createdByUserId String
  saleId          String?          @unique
  createdAt       DateTime         @default(now())

  cashSession CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  createdBy   User        @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  sale        Sale?       @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([cashSessionId])
  @@index([type])
  @@index([createdByUserId])
  @@index([createdAt])
}
