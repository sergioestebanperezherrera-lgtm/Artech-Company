{
  "name": "artech-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API base para ARTECH.",
  "main": "dist/server.js",
  "scripts": {
    "admin:bootstrap-super-admin": "tsx scripts/bootstrap-super-admin.ts",
    "admin:grant": "tsx scripts/grant-super-admin.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx prisma/seed.ts",
    "seed:rbac": "tsx scripts/seed-rbac.ts",
    "test:admin": "tsx --test tests/admin-rbac.test.ts tests/admin-bootstrap.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.2",
    "hash-wasm": "^4.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "prisma": "6.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
